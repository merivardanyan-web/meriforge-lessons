# Անիի ակումբը · Laravel — PHP Դաս 22
# Պատճենիր որպես .env։ Իսկական արժեքները՝ ՄԻԱՅՆ .env-ում, որը .gitignore-ում է
# Ստուգիր․ git log --all --oneline -- .env  → պետք է լինի դատարկ

APP_NAME="Անիի ակումբը"
APP_ENV=production              # local՝ քո մեքենայում
APP_KEY=                        # php artisan key:generate
APP_DEBUG=false                 # ⚠️ true-ն production-ում ցույց կտա .env-ի արժեքները սխալի էջում
APP_URL=https://ani-club.example.am

APP_LOCALE=hy
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ani_books_laravel
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # cookie-ն՝ միայն HTTPS-ով
CACHE_STORE=database

MAIL_MAILER=log

# Միայն hosting-ում՝ DemoSeeder-ի համար
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_PASSWORD=
